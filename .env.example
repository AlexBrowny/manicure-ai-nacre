# Скопируйте этот файл в .env и заполните. Файл .env не попадает в git.

# --- Сервер ---
PORT=3000
# Часовой пояс студии (IANA). От него зависят «сегодня», «сейчас» и напоминания.
STUDIO_TZ=Asia/Tashkent
# Валюта в ценах
CURRENCY=сум
DB_PATH=data/studio.db

# --- Админ-панель (/admin/) ---
# Обязательно задайте свои значения. Без них при каждом запуске создаётся временный пароль.
ADMIN_PASSWORD=
# Длинная случайная строка (например: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=
ADMIN_SESSION_HOURS=12
# 1 — если сайт открыт по https (cookie получит флаг Secure)
COOKIE_SECURE=0
# 1 — если приложение стоит за прокси (nginx, Cloudflare): нужно для корректных IP в лимитах запросов
TRUST_PROXY=0

# --- Telegram-бот ---
# Токен от @BotFather. Без токена бот выключен, сайт и админка работают.
TELEGRAM_BOT_TOKEN=
# Имя бота без @ (нужно для ссылки «получать напоминания в Telegram» на сайте; определяется само при запуске)
TELEGRAM_BOT_USERNAME=
# chat id администраторов через запятую — туда приходят уведомления о записях.
# Узнать свой id: напишите боту /id
ADMIN_CHAT_IDS=

# --- Правила записи ---
# Шаг сетки времени, минут
SLOT_STEP_MIN=30
# Минимум минут от «сейчас» до ближайшей записи
BOOKING_LEAD_MIN=60
# На сколько дней вперёд открыта запись
BOOKING_HORIZON_DAYS=60
# За сколько часов до визита клиент ещё может отменить запись сам
CANCEL_MIN_HOURS=3
# Автонапоминания клиенту в Telegram: за сколько минут до визита, через запятую (120,10 — за 2 часа и за 10 минут)
REMINDER_MINUTES=120,10

# --- Данные студии (показываются на сайте и в боте) ---
STUDIO_NAME=Nacré
STUDIO_TAGLINE=Nail Atelier
STUDIO_ADDRESS=г. Ташкент, ул. Примерная, 12
STUDIO_PHONE=+998 90 000-00-00
STUDIO_HOURS=Ежедневно, 10:00 – 21:00
STUDIO_INSTAGRAM=
